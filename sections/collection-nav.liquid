{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.bg_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

    /* Container */
    .cn-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    }

    .cn-list {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
    }

    /* Individual Card */
    .cn-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 200px;
    text-decoration: none;
    cursor: pointer;
    }

 .cn-image-box {
    width: 100%;
    height: 100%;
    background-color: #f7f7f7;
    border-radius: 5px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    margin-bottom: 12px;
    position: relative;
    box-sizing: border-box;
    max-height: 200px;
    min-height: 165px;
}

    .cn-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
    }

    .cn-item:hover .cn-image {
    transform: scale(1.05);
    }

    /* Active State (Red Border) */
    .cn-item.active .cn-image-box {
    border-color: #B82200; /* The Red Color */
    }


    .cn-title {
    color: {{ section.settings.text_color }};
    font-family: Instrument Sans;
    font-weight: 500;
    font-style: Medium;
    font-size: 14px;
    leading-trim: CAP_HEIGHT;
    line-height: 140%;
    letter-spacing: 0%;
    text-align: center;
    vertical-align: middle;

    }

    @media screen and (max-width: 768px) {
.cn-list {
    gap: 15px;
    position: relative;
    flex-wrap: inherit;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-left: 1.5rem;
    -webkit-overflow-scrolling: touch;
    margin-bottom: 1rem;
    align-items: start;
    justify-content: start;
}
    .cn-item {
      flex: 0 0 116px;
    }
    .cn-image-box {
      max-height: 100%;
      min-height: 118px;

    }
    }

    @media screen and (max-width: 400px) {
    .cn-item {
      flex: 0 0 110px;
    }

    }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
  <div class="cn-container">
    <div class="cn-list">
      {%- for block in section.blocks -%}
        {%- liquid
          # --- LOGIC START ---
          assign is_active = false
          
          if collection.handle != blank and block.settings.collection_ref != blank
            if collection.handle == block.settings.collection_ref.handle
              assign is_active = true
            endif
          endif

          # 2. Fallback: Compare URL paths (For custom links)
          if request.path == block.settings.custom_url
             assign is_active = true
          endif
          
          # --- IMAGE LOGIC ---
          assign image = block.settings.custom_image
          if image == blank and block.settings.collection_ref != blank
             assign image = block.settings.collection_ref.featured_image
          endif
          
          # --- LINK LOGIC ---
          assign link_url = block.settings.custom_url
          if link_url == blank and block.settings.collection_ref != blank
             assign link_url = block.settings.collection_ref.url
          endif
        -%}

        <a href="{{ link_url }}" class="cn-item {% if is_active %}active{% endif %}" {{ block.shopify_attributes }}>
          <div class="cn-image-box">
            {%- if image != blank -%}
              <img 
                src="{{ image | image_url: width: 400 }}" 
                alt="{{ block.settings.title | escape }}" 
                class="cn-image"
                loading="lazy"
                width="400"
                height="320"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'cn-image' }}
            {%- endif -%}
          </div>
          <span class="cn-title">
            {%- if block.settings.title != blank -%}
              {{ block.settings.title }}
            {%- else -%}
              {{ block.settings.collection_ref.title }}
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Navigation",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "collection_item",
      "name": "Category",
      "settings": [
        {
          "type": "header",
          "content": "Configuration"
        },
        {
          "type": "collection",
          "id": "collection_ref",
          "label": "Select Collection",
          "info": "Selection here ensures the 'Active' border works correctly."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Overrides the collection title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image",
          "info": "Overrides the collection image"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link (Optional)",
          "info": "Only use if not selecting a collection above."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Navigation",
      "blocks": [
        { "type": "collection_item" },
        { "type": "collection_item" },
        { "type": "collection_item" }
      ]
    }
  ]
}
{% endschema %}