{% schema %}
{
  "name": "Wholesale Inquiry",
  "settings": [],
  "blocks": [
    {
      "type": "table_row",
      "name": "Table Row",
      "settings": [
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Name",
          "default": "LUXIAOJUN Product"
        },
        {
          "type": "text",
          "id": "min_amount",
          "label": "Min Amount",
          "default": "50"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wholesale Inquiry Form"
    }
  ]
}
{% endschema %}