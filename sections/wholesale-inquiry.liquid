

{% style %}

  .ws-section {
    padding: 60px 20px;
    background-color: #ffffff;
    font-family: 'Instrument Sans', sans-serif;
    color: #333;
  }

  .ws-container {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 80px;
  }

  .ws-form-col {
    flex: 1;
    min-width: 350px;
  }

  .ws-field-group {
    margin-bottom: 25px;
  }

  .ws-label {
    display: block;
    font-size: 14px;
    color: #000; /* Light gray label color */
    margin-bottom: 8px;
    font-weight: 400;
  }

  .ws-input, 
  .ws-select, 
  .ws-textarea {
    width: 100%;
    padding: 12px 15px;
    border: 1px solid #e1e1e1;
    border-radius: 0; /* Square edges */
    font-family: 'Instrument Sans', sans-serif;
    font-size: 14px;
    color: #000;
    background-color: #fff;
    box-sizing: border-box;
    appearance: none; /* Removes default browser styling */
  }

  /* Custom Arrow for Select Boxes */
  .ws-select-wrapper {
    position: relative;
  }
  .ws-select-wrapper::after {
    content: "↓";
    font-size: 12px;
    position: absolute;
    right: 15px;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: #999;
  }

  .ws-textarea {
    min-height: 200px;
    resize: vertical;
  }

  .ws-submit {
    background-color: #000;
    color: #fff;
    border: none;
    padding: 15px 40px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    transition: background 0.2s;
    margin-top: 10px;
  }

  .ws-submit:hover {
    background-color: #333;
  }

  /* --- Right Column: Table --- */
  .ws-table-col {
    flex: 0 0 450px; /* Fixed width for table column */
    padding-top: 25px; /* Align with form inputs */
  }

  .ws-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    color: #000;
  }

  .ws-table th {
    text-align: left;
    font-weight: 500;
    color: #000;
    border-bottom: 1px solid #eee;
    padding-bottom: 15px;
    text-transform: uppercase;
    font-size: 13px;
  }

  .ws-table th:last-child {
    text-align: right;
  }

  .ws-table td {
    padding: 20px 0;
    border-bottom: 1px solid #f5f5f5;
    line-height: 1.4;
  }

  .ws-table td:last-child {
    text-align: right;
    font-weight: 500;
    padding-left: 20px;
  }

  /* Mobile Responsive */
  @media (max-width: 900px) {
    .ws-container {
      flex-direction: column;
      gap: 40px;
    }
    .ws-table-col {
      flex: 1;
      width: 100%;
    }
  }
{% endstyle %}

