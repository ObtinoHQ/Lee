{%- style -%}
  #custom-banner-{{ section.id }} {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  #custom-banner-{{ section.id }} .banner-image-wrapper {
    width: 100%;
    overflow: hidden;
    position: relative;
    {% if section.settings.adapt_height_mobile %}
      height: auto;
    {% else %}
      height: {{ section.settings.min_height_mobile }}px;
    {% endif %}
  }

  /* Base Image/Video Styles */
  #custom-banner-{{ section.id }} .banner-image,
  #custom-banner-{{ section.id }} .banner-video,
  #custom-banner-{{ section.id }} .hp-hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover; 
    object-position: top;
    display: block;
  }

  #custom-banner-{{ section.id }} .banner-image {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: crisp-edges;
  }

  /* Hide Desktop assets by default on Mobile to prevent flash */
  #custom-banner-{{ section.id }} .banner-image-desktop {
    display: none;
  }

  /* Fallback: Show Desktop/Video on Mobile ONLY if Mobile Image is missing */
  .banner-image-mobile:empty + .banner-image-desktop,
  .banner-image-wrapper:not(:has(.banner-image-mobile)) .banner-image-desktop {
    display: block !important;
  }

  /* Content Positioning */
  #custom-banner-{{ section.id }} .banner-content {
    position: absolute;
    top: {{ section.settings.text_position_top }}%;
    left: {{ section.settings.text_position_left }}%;
    transform: translate(-{{ section.settings.text_position_left }}%, -{{ section.settings.text_position_top }}%);
    z-index: 2;
    text-align: {{ section.settings.text_alignment }};
    max-width: 650px;
    width: 100%;
    padding: 20px;
  }

  /* Typography */
  #custom-banner-{{ section.id }} .banner-heading * {
    font-family: 'Bebas Neue', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: 88px;
    line-height: 80px;
    letter-spacing: 0;
    vertical-align: middle;
    text-transform: uppercase;
    margin-bottom: 10px;
    color: {{ section.settings.text_color_mobile | default: 'white' }};
  }

  #custom-banner-{{ section.id }} .banner-subheading * {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 16px;
    line-height: 1.3;
    letter-spacing: 0;
    margin-bottom: 20px;
    color: {{ section.settings.text_color_mobile | default: 'white' }};
  }

  #custom-banner-{{ section.id }} .btn-custom-banner {
    display: flex;
    gap: 20px;
    justify-content: {% if section.settings.text_alignment == 'center' %}center{% elsif section.settings.text_alignment == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  /* --- LARGE DESKTOP --- */
  @media (min-width: 1480px) {
    #custom-banner-{{ section.id }} .banner-image {
      {% unless section.settings.adapt_height_desktop %}
        object-position: unset;
      {% endunless %}
      {% if request.page_type == 'collection' %} 
        object-position: 100% 10%;
      {% endif %}
    }
  }

  /* --- DESKTOP (768px and up) --- */
  @media (min-width: 768px) {
    #custom-banner-{{ section.id }},
    #custom-banner-{{ section.id }} .banner-image-wrapper {
      {% if section.settings.adapt_height_desktop %}
        height: auto;
      {% else %}
        height: {{ section.settings.min_height_desktop }}px;
      {% endif %}
    }

    /* Swap visibility for Desktop */
    #custom-banner-{{ section.id }} .banner-image-desktop {
      display: block;
    }
    #custom-banner-{{ section.id }} .banner-image-mobile {
      display: none;
    }

    #custom-banner-{{ section.id }} .banner-heading *,
    #custom-banner-{{ section.id }} .banner-subheading * {
      color: white; /* Force white on desktop if mobile has different color */
    }
  }

  /* --- MOBILE (767px and below) --- */
  @media (max-width: 767px) {
    #custom-banner-{{ section.id }} .banner-image-mobile {
      height: 550px;
      object-position: unset;
    }

    #custom-banner-{{ section.id }} .hp-hero__video {
      height: 75vh;
      aspect-ratio: 9/16;
    }

    #custom-banner-{{ section.id }} .banner-content {
      max-width: 100%;
      padding: 10px;
      top: {% if request.page_type == 'collection' %}70%{% else %}95%{% endif %};
    }

    #custom-banner-{{ section.id }} .banner-heading * {
      font-size: {% if request.page_type == 'collection' %}48px{% else %}58px{% endif %};
      line-height: 48px;
    }
  }
{%- endstyle -%}

<div id="custom-banner-{{ section.id }}" class="custom-banner-section {% if section.settings.show_mobile_content_below %}mobile-content-below{% endif %} {{ section.settings.custom_class }}">
  <div class="banner-image-wrapper">

    {%- comment -%} 1. Mobile Image Logic {%- endcomment -%}
    {%- if section.settings.mobile_image != blank -%}
      <img 
        src="{{ section.settings.mobile_image | image_url: width: 1000 }}"
        srcset="{{ section.settings.mobile_image | image_url: width: 400 }} 400w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w"
        sizes="100vw"
        alt="{{ section.settings.mobile_image.alt | escape }}"
        class="banner-image banner-image-mobile"
        loading="{{ section.settings.loading_type }}"
        width="{{ section.settings.mobile_image.width }}"
        height="{{ section.settings.mobile_image.height }}"
      >
    {%- endif -%}

    {%- comment -%} 2. Desktop Fallback Logic based on Schema 'media_type' {%- endcomment -%}
    {%- if section.settings.media_type == 'video' and section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          class: 'hp-hero__video banner-video banner-image-desktop',
          loading: 'lazy'
      }}
    {%- elsif section.settings.media_type == 'image' and section.settings.image != blank -%}
      <img 
        src="{{ section.settings.image | image_url: width: 2000 }}"
        class="banner-image banner-image-desktop"
        loading="{{ section.settings.loading_type }}"
        width="{{ section.settings.image.width }}" 
        height="{{ section.settings.image.height }}"
        alt="{{ section.settings.image.alt | escape }}"
      >
    {%- endif -%}
  </div>

  <div class="banner-content">
    {% if section.settings.heading != blank %}
      <div class="banner-heading">{{ section.settings.heading }}</div>
    {% endif %}
    
    {% if section.settings.subheading != blank %}
      <div class="banner-subheading">{{ section.settings.subheading }}</div>
    {% endif %}

    {%- comment -%} FIXED: Wrap buttons securely so unclosed divs don't break layout {%- endcomment -%}
    {% if section.settings.button_text != blank or section.settings.button_text2 != blank %}
      <div class="btn-custom-banner">
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="theme-btn">{{ section.settings.button_text }}</a>
        {% endif %}
        
        {% if section.settings.button_text2 != blank %}
          <a href="{{ section.settings.button_link2 }}" class="theme-btn">{{ section.settings.button_text2 }}</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom Image Banner",
  "settings": [
    {
      "type": "header",
      "content": "Media Configuration",
      "info": "Choose between a static image or a background video."
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media Type",
      "options": [
        { "value": "image", "label": "Static Image" },
        { "value": "video", "label": "Background Video" }
      ],
      "default": "image"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Banner Video (MP4)",
      "info": "Upload an MP4. Video will loop silently in the background."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Image",
      "info": "Recommended: 2500px width for high-resolution screens."
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image",
      "info": "Optional. Improves loading speed and framing on phones."
    },
    {
      "type": "select",
      "id": "loading_type",
      "label": "Browser Loading Priority",
      "options": [
        { "value": "eager", "label": "Eager (High Priority - Above Fold)" },
        { "value": "lazy", "label": "Lazy (Better Performance)" }
      ],
      "default": "eager"
    },
    {
      "type": "header",
      "content": "Banner Height",
      "info": "Control how tall the banner appears on different devices."
    },
    {
      "type": "checkbox",
      "id": "adapt_height_desktop",
      "label": "Adapt to Image Height (Desktop)",
      "default": false
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Fixed Desktop Height",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "adapt_height_mobile",
      "label": "Adapt to Image Height (Mobile)",
      "default": false
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Fixed Mobile Height",
      "default": 400
    },
    {
      "type": "header",
      "content": "Text Content"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Main Heading"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading / Description"
    },
    {
      "type": "header",
      "content": "Content Positioning"
    },
    {
      "type": "range",
      "id": "text_position_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Vertical Position",
      "default": 50
    },
    {
      "type": "range",
      "id": "text_position_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "Horizontal Position",
      "default": 50
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Mobile Styles"
    },
    {
      "type": "color",
      "id": "text_color_mobile",
      "label": "Text Color (Mobile)",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "show_mobile_content_below",
      "label": "Stack Content Below Image",
      "default": true,
      "info": "Better for readability on small portrait screens."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Label 1",
      "default": "See the Design in Action"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link 1"
    },
    {
      "type": "text",
      "id": "button_text2",
      "label": "Button Label 2",
      "default": "See the Design in Action"
    },
    {
      "type": "url",
      "id": "button_link2",
      "label": "Button Link 2"
    }
  ],
  "presets": [
    {
      "name": "Custom Image Banner"
    }
  ]
}
{% endschema %}