

{% style %}


  .terms-section-wrapper {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding: 60px 20px;
    font-family: 'Instrument Sans', sans-serif;
    overflow: hidden;
  }

  .terms-container {
    max-width: 800px;
    margin: 0 auto;
  }

  /* --- Typography --- */
  .terms-main-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 48px;
    line-height: 1;
    text-transform: uppercase;
    margin-bottom: 30px;
    letter-spacing: 1px;
    color: {{ section.settings.heading_color }};
  }

  .terms-section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    line-height: 1.1;
    text-transform: uppercase;
    margin-bottom: 15px;
    letter-spacing: 0.5px;
    color: {{ section.settings.heading_color }};
  }

  /* Body Text Styles as requested */
  .terms-text p, 
  .terms-text li,
  .terms-intro p {
    font-family: 'Instrument Sans', sans-serif;
    font-weight: 500; /* Medium */
    font-size: 16px;
    line-height: 1.4; /* Adjusted from 100% to 1.4 for readability, as 100% crashes multiline text */
    letter-spacing: 0;
    margin-bottom: 20px;
    color: {{ section.settings.text_color }};
  }

  .terms-text ul {
    list-style-type: disc;
    padding-left: 20px;
    margin-bottom: 20px;
  }
  
  .terms-text li {
    margin-bottom: 5px;
  }

  /* --- Divider Style --- */
  .terms-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 40px 0;
    opacity: 0.6;
  }
  .terms-divider span {
    height: 1px;
    background-color: {{ section.settings.text_color }};
    flex: 1;
  }
  .terms-divider i {
    width: 8px;
    height: 8px;
    border: 1px solid {{ section.settings.text_color }};
    transform: rotate(45deg); /* Diamond shape */
    margin: 0 15px;
    display: block;
  }

{% endstyle %}

<div class="terms-section-wrapper">
  <div class="terms-container">
    
    {%- if section.settings.main_heading != blank -%}
      <h1 class="terms-main-title">{{ section.settings.main_heading }}</h1>
    {%- endif -%}

    {% comment %} --- Render Blocks --- {% endcomment %}
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        
        {%- when 'intro_text' -%}
          <div class="terms-intro" {{ block.shopify_attributes }}>
            {{ block.settings.text }}
          </div>

        {%- when 'divider' -%}
          <div class="terms-divider" aria-hidden="true" {{ block.shopify_attributes }}>
            <span></span><i></i><span></span>
          </div>

        {%- when 'content_section' -%}
          <section class="terms-section" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2 class="terms-section-title">{{ block.settings.heading }}</h2>
            {%- endif -%}
            <div class="terms-text">
              {{ block.settings.content }}
            </div>
          </section>

      {%- endcase -%}
    {%- endfor -%}

  </div>
</div>

