<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-search.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-notification.css' | asset_url }}"media="print"onload="this.media='all'">

{%- if settings.predictive_search_enabled -%}
  <link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

{%- if section.settings.menu_type_desktop == 'mega' -%}
  <link rel="stylesheet" href="{{ 'component-mega-menu.css' | asset_url }}" media="print" onload="this.media='all'">
{%- endif -%}

<style>
  {%- if section.settings.sticky_header_type == 'reduce-logo-size' -%}
    .scrolled-past-header .header__heading-logo-wrapper {
      width: 75%;
    }
  {%- endif -%}

  {%- if section.settings.menu_type_desktop != "drawer" -%}
    @media screen and (min-width: 990px) {
      header-drawer {
        display: none;
      }
    }
  {%- endif -%}

  .menu-drawer-container {
    display: flex;
  }
  .list-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }
.list-menu--inline {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
}

  summary.list-menu__item {
    padding-right: 0.7rem;
  }

.list-menu__item {
    display: flex;
    align-items: center;
    line-height: calc(1 + 0.3 / var(--font-body-scale));

}

  .list-menu__item--link {
    text-decoration: none;
    padding-bottom: 1rem;
    padding-top: 1rem;
    line-height: calc(1 + 0.8 / var(--font-body-scale));
  }

  @media screen and (min-width: 750px) {
    .list-menu__item--link {
      padding-bottom: 0.5rem;
      padding-top: 0.5rem;
    }
  }

  img.header__heading-logo.header-logo--transparent {
    display: none;
}


{% if template.name == 'index' and section.settings.enable_transparent_header %}
  img.header__heading-logo.header-logo--transparent {
  display: none
}
  .header--transparent--cc .desktopMenu-Item{
    color: #fff;
  }
  .header--transparent--cc .header__menu-item a{
    color: #fff;
  }
  body:has(.scrolled-past-header) .desktopMenu-Item{
    color: #000;
  }
.header--transparent--cc .header__menu-item .icon-caret path {
  stroke: white;
}
.header__heading-logo {
    max-width: 100%;
    object-fit: cover;
}
img.header__heading-logo.header-logo--transparent {
    width: 200px;
    object-fit: contain;
    display: block;
}
.header--transparent--cc .header-drawer{
  border: none;
}
body:has(.scrolled-past-header) .header.header--transparent--cc {
    transform: translateY(2px);
    background: #000 !important;
    z-index: 99;
}
/* When the menu drawer is OPEN, force these styles on the header */
.header-wrapper:has(details[open]) .header--transparent--cc,
.header:has(details[open]) {
    background: #000 !important;
    transform: translateY(0); /* Usually better to reset transform when open */
    z-index: 100;
}

/* Specific target for your transparent class when active */
.header--transparent--cc:has(details[open]) {
    background: #000 !important;
    opacity: 1;
}
.header--transparent--cc .header__icon  svg path{
    fill: #fff;
}
.header--transparent--cc .header__search  svg path{
    fill: #fff;
}
body:has(.mega-menu[open]) .header--transparent--cc .header__menu-item span {
  color: #000;
}
body:has(.header--transparent--cc) .utility-bar {
  height: 101%;
}
body:has(.scrolled-past-header)
  .header--transparent--cc
  .header__menu-item
  .icon-caret
  path {
  stroke: #fff;
}
.header--transparent--cc {
  background-color: transparent !important;
  box-shadow: none !important;
  position: absolute;
  top: -4px;
  left: 0;
  width: 100%;
  transition: background-color 0.4s ease, box-shadow 0.4s ease,
  transform 0.4s ease;
}

.header--transparent--cc .header__menu-item span {
  color: #fff;
}
body:has(.mega-menu[open])
  .header--transparent--cc
  .header__menu-item
  .icon-caret
  path {
  stroke: black;
}
{% comment %} 
body:has(.scrolled-past-header) .cart-count-bubble {
    background-color:  #000;
} {% endcomment %}
body:has(.scrolled-past-header) .header--transparent--cc .header-logo--transparent,
 .header--transparent--cc:hover .header-logo--transparent {
  display: none;
}
body:has(.scrolled-past-header)  .desktopMenu-Item{
color: #fff;
}
 .desktopMenu-Item svg path{
  fill: #fff;
}
body:has(.scrolled-past-header) .desktopMenu-Item svg path{
  fill: #fff;
}
 .header--transparent--cc .header__heading-logo.motion-reduce {
  display: none;
}
body:has(.scrolled-past-header) .header--transparent--cc .header__heading-logo.motion-reduce,
.header--transparent--cc:hover .header__heading-logo.motion-reduce {
  display: block;
}
.header--transparent--cc .header__icon--menu .icon path {
    fill: #fff;
}
body:has(.scrolled-past-header) .header--transparent--cc .header__icon--menu .icon  {
    fill: #000;
}

.header--transparent--cc:hover {
  background: #000 !important;
}
.header--transparent--cc:hover .header__menu-item span,
.header--transparent--cc:hover .desktopMenu-Item {
  color: #fff;
}
{% endif %}

</style>

{%- style -%}
  .section-header {
    position: sticky;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }


{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator %} header-wrapper--border-bottom{% endif %}"
>
  {%- liquid
    assign social_links = false
    assign localization_forms = false

    if settings.social_twitter_link != blank or settings.social_facebook_link != blank or settings.social_pinterest_link != blank or settings.social_instagram_link != blank or settings.social_youtube_link != blank or settings.social_vimeo_link != blank or settings.social_tiktok_link != blank or settings.social_tumblr_link != blank or settings.social_snapchat_link != blank
      assign social_links = true
    endif

    if localization.available_countries.size > 1 and section.settings.enable_country_selector or section.settings.enable_language_selector and localization.available_languages.size > 1
      assign localization_forms = true
    endif
  -%}
  <header class="container {% if template.name == 'index' and section.settings.enable_transparent_header %}header--transparent--cc{% endif %} {% if template.name == 'index' %}header--transparent--index{% endif %}  header header--{{ section.settings.logo_position }} header--mobile-{{ section.settings.mobile_logo_position }}{% if section.settings.menu_type_desktop == 'drawer' %} drawer-menu{% endif %}{% if section.settings.menu != blank %} header--has-menu{% endif %}{% if has_app_block %} header--has-app{% endif %}{% if social_links %} header--has-social{% endif %}{% if shop.customer_accounts_enabled %} header--has-account{% endif %}{% if localization_forms %} header--has-localizations{% endif %}">
    {%- liquid
      if section.settings.menu != blank
        render 'header-drawer'
      endif

      if section.settings.logo_position == 'top-center' or section.settings.menu == blank
        render 'header-search', input_id: 'Search-In-Modal-1'
      endif
