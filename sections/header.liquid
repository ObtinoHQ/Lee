    {%- if request.page_type == 'index' -%}
      <h1 class="header__heading">
    {%- endif -%}
  <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
    
    {%- comment -%} 
      FIX: Check if the main logo exists first. 
      If it does, we render the logo wrapper.
    {%- endcomment -%}
    {%- if settings.logo != blank -%}
      
      {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
      {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
      {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 100vw, {{ settings.logo_width }}px{% endcapture %}
      {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 2 | round }}, {{ settings.logo_width | times: 3 | round }}, {{ settings.logo_width | times: 4 | round }}{% endcapture %}
      
      <div class="header__heading-logo-wrapper header-about-cc">
        
        {%- comment -%} 
          Only render the Transparent Logo image specifically if:
          1. It is the Index (Home) page
          2. Transparent Header setting is ON
          3. A transparent logo image is actually uploaded
        {%- endcomment -%}
        {%- if template.name == 'index' and section.settings.enable_transparent_header and section.settings.transparent_logo != blank -%}
          <img 
            src="{{ section.settings.transparent_logo | image_url }}"
            alt="{{ shop.name }}"
