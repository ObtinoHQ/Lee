      </div>

    {%- else -%}
      {%- comment -%} If no logo is uploaded in settings, show text {%- endcomment -%}
      <span class="h2">{{ shop.name }}</span>
    {%- endif -%}

  </a>
    {%- if request.page_type == 'index' -%}
      </h1>
