



<product-info
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
  {% if section.settings.image_zoom == 'hover' %}
    data-zoom-on-hover
  {% endif %}
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}

  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
    .product  span.badge.price__badge-sale { 
    display: none !important;
    }
    .product .card__badge {
    display: flex!important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 5px;
    }

    .product .price__regular .price-item--regular {
    font-size: 20px;
    }
    .drawer__upsell-container-mobile .price__regular .price-item--regular {
    font-size: 15px;
    }
    .product  .price-item.price-item--sale.price-item--last {
    font-weight: 500;
    font-style: Medium;
    font-size: 20px;
    line-height: 100%;
    letter-spacing: 0%;
    color: #000;
    }
    @media screen and (max-width: 750px) {
    .cart-drawer__overlay:empty {
    display: none !important;
    }
    .drawer{
    background: transparent;
    }
    .price__sale {
    flex-direction: row !important;
    align-items: center !important;
    gap: 10px;
    }
    }
  {%- endstyle -%}


  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
  <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %} container-x">
      <div class="grid__item product__media-wrapper {% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"> 
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <section
          id="ProductInfo-{{ section.id }}"
          class="product__info-container"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'text' -%}
                <p
                  class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                  {{ block.shopify_attributes }}
                >
                  {{- block.settings.text -}}
                </p>
                      {%- when 'title' -%}
                          <div class="price-title-cc">
                          <h1 class="product__title {{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                            {%- unless placeholder -%}
                              {{ product.title | escape }}
                            {%- else -%}
                              {{ 'onboarding.product_title' | t }}
                            {%- endunless -%}
                          </h1>
                        </div>
                                 {%- when 'divider' -%}
               <div class="divider--wrapper"></div>
                                   {%- when 'gift-card' -%}
                {% render 'gift-card' block: block %}
            
              {%- when 'multi-icon' -%}
                {% render 'multi-icon' block: block %}
{%- when 'trust_badges' -%}
  <style>
    .trust-badges-container-{{ block.id }} {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-top: {{ block.settings.margin_top }}px;
      margin-bottom: 20px;
      border-top: 1px solid #eee;
      padding-top: 15px;
    }

    .trust-badge-{{ block.id }} {
      display: flex;
      align-items: center;
      gap: 8px;
      color: {{ block.settings.color }};
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.02em;
      text-transform: capitalize;
    }

    .trust-badge-{{ block.id }} img, 
    .trust-badge-{{ block.id }} svg {
      width: {{ block.settings.icon_width }}px;
      height: auto;
      flex-shrink: 0;
      stroke: {{ block.settings.color }};
    }

    @media (max-width: 480px) {
      .trust-badges-container-{{ block.id }} {
        gap: 12px;
        align-items: center;
      }
    }
  </style>

  <div class="trust-badges-container-{{ block.id }}">
    {%- for i in (1..2) -%}
      {%- assign img_setting = 'image_' | append: i -%}
      {%- assign text_setting = 'text_' | append: i -%}
      
      <div class="trust-badge-{{ block.id }}">
        {%- if block.settings[img_setting] != blank -%}
          {{ block.settings[img_setting] | image_url: width: 50 | image_tag: loading: 'lazy' }}
        {%- else -%}
          {%- if i == 1 -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          {%- else -%}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          {%- endif -%}
        {%- endif -%}
        <span>{{ block.settings[text_setting] }}</span>
      </div>
    {%- endfor -%}
  </div>
{%- when 'Back-in-stock' -%}
{% unless product.available %}
<style>
  #sold-out-container {
    margin: 20px 0;
    padding: 15px;
    border: 1px solid #000;
    border-radius: 4px;
    background: #fafafa;
  }
  .notify-header {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: color 0.3s ease;
  }

  .notify-header:hover { color: #000; }

  #notify-me-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s ease, opacity 0.4s ease, margin-top 0.4s ease;
    opacity: 0;
    overflow: hidden;
  }

  #notify-me-wrapper.is-visible {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 15px;
  }

  .notify-inner {
    min-height: 0;
    display: flex;
    gap: 8px;
  }

.notify-input {
    flex-grow: 1;
    height: 48px;
    border: none; /* Removes the default border */
    outline: none; /* Removes the focus ring */
    background-color: #f2f2f2; /* Light grey background */
    padding: 0 20px;
    text-transform: capitalize;
    font-size: 12px;
    letter-spacing: 1px;
        font-family: 'Instrument Sans';
    border-radius: 50px; /* Matches the rounded style of the send button */
    transition: background-color 0.3s ease;
  }

  .notify-input:focus {
    background-color: #e8e8e8; /* Slightly darker on click for feedback */
  }

  /* Adjusting the Send button to match the height and rounded style */
  .notify-btn {
    background: #000;
    color: #fff;
    border: none;
    padding: 0 30px;
    font-weight: 600;
    text-transform: capitalize;
    cursor: pointer;
    border-radius: 50px;
        font-family: 'Instrument Sans';
    transition: transform 0.2s ease, background 0.3s ease;
  }

  .notify-btn:active {
    transform: scale(0.96); /* Small "click" animation */
  }


  .notify-btn:hover { background: #333; }

  .success-msg { color: #28a745; font-weight: 600; text-transform: capitalize; font-size: 12px; }
</style>

<div id="sold-out-container">
  {% form 'contact' %}
    {% if form.posted_successfully? %}
      <p class="success-msg">✓ We'll notify you when this is back!</p>
    {% else %}
      
      <div class="notify-header" id="notify-trigger">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        <span style="font-weight: 600; text-transform: capitalize; font-size: 13px;">Notify me when available</span>
      </div>

      <div id="notify-me-wrapper">
        <div class="notify-inner">
          {% if customer %}
            <input type="hidden" name="contact[email]" value="{{ customer.email }}" />
            <p style="font-size: 13px;">Notifying: <strong>{{ customer.email }}</strong></p>
          {% else %}
            <input class="notify-input" required type="email" name="contact[email]" placeholder="Enter Your Email" value="{{ contact.fields.email }}" />
          {% endif %}
          <input type="hidden" name="contact[body]" value="Please notify me when {{ product.title | escape }} becomes available." />
          <button type="submit" class="notify-btn">Submit</button>
        </div>
      </div>
      
    {% endif %}
  {% endform %}
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const trigger = document.querySelector('#notify-trigger');
  const wrapper = document.querySelector('#notify-me-wrapper');
  
  if (trigger && wrapper) {
    trigger.addEventListener('click', () => {
      wrapper.classList.toggle('is-visible');
    });
  }
});
</script>
