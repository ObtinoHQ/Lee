{% style %}
  .fc-section {
    padding: 60px 20px;
    background-color: #ffffff;
    font-family: 'Instrument Sans', sans-serif;
    color: #000;
  }

  .fc-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    gap: 60px;
  }

  .fc-col {
    flex: 1;
    min-width: 300px;
  }

  .fc-subheading {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: 3000;
    margin-bottom: 10px;
    display: block;
  }

  .fc-heading {
    font-family: 'Instrument Sans', sans-serif;
    font-size: 24px;
    font-weight: 400; 
    text-transform: uppercase;
    color: #666;
    margin: 0 0 30px 0;
    line-height: 1.2;
  }

  /* Accordion Styles */
  .fc-accordion-item {
    border-bottom: 1px solid #eee;
  }

  .fc-accordion-item:first-child {
    border-top: 1px solid #eee;
  }

  .fc-summary {
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 15px;
    color: #666;
    transition: color 0.2s;
  }

  .fc-summary::-webkit-details-marker {
    display: none;
  }

  .fc-summary:after {
    content: '+';
    font-size: 18px;
    color: #ccc;
    font-weight: 300;
  }

  details[open] .fc-summary:after {
    content: '-';
  }

  details[open] .fc-summary {
    color: #d32f2f; 
  }

  .fc-answer {
    padding-bottom: 20px;
    font-size: 14px;
    line-height: 1.6;
    color: #666;
  }

  /* Form Styles */
  .fc-form-row {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
  }

  .fc-field {
    flex: 1;
  }

  .fc-label {
    display: block;
    font-size: 13px;
    color: #999;
    margin-bottom: 8px;
  }

  .fc-input, .fc-textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #eee;
    font-family: inherit;
    font-size: 14px;
    color: #000;
    background: #fff;
    box-sizing: border-box;
    border-radius: 0;
  }

  .fc-input:focus, .fc-textarea:focus {
    outline: none;
    border-color: #ccc;
  }

  .fc-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .fc-submit {
    background-color: #000;
    color: #fff;
    border: none;
    padding: 15px 30px;
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    margin-top: 10px;
    transition: background 0.3s;
  }

  .fc-submit:hover {
    background-color: #000;
  }

  @media (max-width: 768px) {
    .fc-container {
      flex-direction: column;
      gap: 40px;
    }
    .fc-form-row {
      flex-direction: column;
      gap: 15px;
    }
  }
{% endstyle %}

<div class="fc-section">
  <div class="fc-container">
    
    <div class="fc-col">
      <span class="fc-subheading">{{ section.settings.faq_subheading }}</span>
      <h2 class="fc-heading">{{ section.settings.faq_heading }}</h2>

      <div class="fc-accordion">
        {%- for block in section.blocks -%}
          <details class="fc-accordion-item">
            <summary class="fc-summary">{{ block.settings.question }}</summary>
            <div class="fc-answer">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>

    <div class="fc-col">
      <span class="fc-subheading">{{ section.settings.contact_subheading }}</span>
      <h2 class="fc-heading">{{ section.settings.contact_heading }}</h2>

      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p class="fc-success">Thanks for contacting us. We'll get back to you shortly.</p>
        {% endif %}
        
        {{ form.errors | default_errors }}

        <div class="fc-form-row">
          <div class="fc-field">
            <label class="fc-label">Your Name</label>
            <input type="text" name="contact[name]" class="fc-input" required>
          </div>
          <div class="fc-field">
            <label class="fc-label">Your Email</label>
            <input type="email" name="contact[email]" class="fc-input" required>
          </div>
        </div>

        <div class="fc-form-row">
          <div class="fc-field">
            <label class="fc-label">Phone Number</label>
            <input type="tel" name="contact[phone]" class="fc-input">
          </div>
          <div class="fc-field">
            <label class="fc-label">Company</label>
            <input type="text" name="contact[company]" class="fc-input">
          </div>
        </div>

        <div class="fc-field" style="margin-bottom: 20px;">
          <label class="fc-label">Your Message</label>
          <textarea name="contact[body]" class="fc-textarea" required></textarea>
        </div>

        <button type="submit" class="fc-submit">ASK A QUESTION</button>
      {% endform %}
    </div>

  </div>
</div>

<script>
  // Optional: Auto-close other accordion items when one is opened
  document.querySelectorAll('.fc-accordion-item').forEach((targetDetail) => {
    targetDetail.addEventListener("click", () => {
      document.querySelectorAll('.fc-accordion-item').forEach((detail) => {
        if (detail !== targetDetail) {
          detail.removeAttribute("open");
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "FAQ & Contact",
  "settings": [
    {
      "type": "text",
      "id": "faq_subheading",
      "label": "FAQ Subheading",
      "default": "INFORMATION QUESTIONS"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "FAQ Heading",
      "default": "FREQUENTLY ASKED QUESTIONS"
    },
    {
      "type": "text",
      "id": "contact_subheading",
      "label": "Contact Subheading",
      "default": "INFORMATION ABOUT US"
    },
    {
      "type": "text",
      "id": "contact_heading",
      "label": "Contact Heading",
      "default": "CONTACT US FOR ANY QUESTIONS"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How can I create an account?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>You can modify the information on your account by clicking on Login/Register.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ & Contact Section",
      "blocks": [
        { "type": "faq_item" },
        { "type": "faq_item", "settings": { "question": "How do I determine size?" } },
        { "type": "faq_item", "settings": { "question": "Can I make changes to my order?" } }
      ]
    }
  ]
}
{% endschema %}