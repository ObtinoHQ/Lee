{% schema %}
{
  "name": "Image With Text Custom",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Displayed if no video is selected."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Overrides the image if selected."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
  ],
  "blocks": [
    {
      "type": "headline",
      "name": "Headline",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "DEFY THE LIMITS. TRAIN WITH US."
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading Size",
          "options": [
            {
              "value": "h2",
              "label": "Small"
            },
            {
              "value": "h1",
              "label": "Medium"
            },
            {
              "value": "h0",
              "label": "Large"
            }
          ],
          "default": "h1"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>At LUXIAOJUN, we create professional-grade gear for those who train with intention.</p>"
        }
      ]
    },
    {
      "type": "button",
      "name": "Button",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Become A Champion"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image With Text Custom",
      "blocks": [
        {
          "type": "headline"
        },
        {
          "type": "text"
        },
        {
          "type": "text"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .lux-hero-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .lux-hero-banner {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .lux-hero-media {
    width: 100%;
    flex: 1 1 50%;
    position: relative;
    overflow: hidden;
    min-height: 400px;
  }

  .lux-hero-media img, .lux-hero-media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }

  .lux-hero-content {
    flex: 1 1 50%;
    padding: 4rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background-color: {{ section.settings.background_color }}; /* Ensure content bg matches */
  }

  @media screen and (min-width: 750px) {
    .lux-hero-content {
      padding: 6rem 4rem;
    }
  }

  .lux-hero-content h2.h1 {
font-family: Bebas Neue;
font-weight: 400;
font-style: Regular;
font-size: 48px;
leading-trim: CAP_HEIGHT;
line-height: 45px;
letter-spacing: 0%;
vertical-align: middle;
text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }

  .lux-hero-content .rte {
    font-size: 1.6rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    color: {{ section.settings.text_color }};
  }


  .lux-hero-content .button:hover {
    background-color: {{ section.settings.button_color | color_darken: 10 }};
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding">
    <div class="lux-hero-banner">
      <div class="lux-hero-media">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
        {%- elsif section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy', sizes: '100vw', widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="lux-hero-content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'headline' -%}
              <h2 class="{{ block.settings.heading_size }}" {{ block.shopify_attributes }}>
                {{ block.settings.heading | escape }}
              </h2>
            {%- when 'text' -%}
              <div class="rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>
            {%- when 'button' -%}
              {%- if block.settings.button_label != blank -%}
                <a href="{{ block.settings.button_link }}" class="button" {{ block.shopify_attributes }}>
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
</div>