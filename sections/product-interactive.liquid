

<style>
.pf-section {
overflow: hidden;
}

.pf-container {
background-color:#F7F7F7;
}
.pf-header {
font-family: Bebas Neue;
font-weight: 400;
font-size: 48px;
line-height: 60px;
letter-spacing: 0%;
vertical-align: middle;
text-transform: uppercase;
color: #000;
margin: 0px;
text-align: center;
}

.pf-swiper {
width: 100%;
overflow: visible !important;
}

.pf-slide-inner {
display: flex;
align-items: center;
justify-content: center;
position: relative;
width: 100%;
}

.pf-svg-overlay {
position: absolute;
top: 0;
left: 0;
width: 100%;
height: 100%;
pointer-events: none; 
z-index: 10;
}

.pf-connector-line {
stroke: #c2260d;
stroke-width: 2;
fill: none;
}
.pf-dot {
display: block !important;
}

.pf-col-left, .pf-col-right {
max-width: 500px;
display: flex;
flex-direction: column;
justify-content: center;
z-index: 20;
position: relative;
flex-shrink: 0;
}

.pf-col-right { gap: 100px; } /* Gap between right cards */

.pf-image-wrapper {
flex-grow: 1;
position: relative;
z-index: 5;
display: flex;
justify-content: center;
align-items: center;
height: 100%;
padding: 0 20px;
}

.pf-image-wrapper img {
width: 100%;
max-width: 600px;
height: auto;
object-fit: contain;
}

@keyframes pf-pulse {
0% {
  /* Start with a solid, tight shadow */
  box-shadow: 0 0 0 0 rgba(194, 38, 13, 0.7);
}
70% {
  /* Expand the shadow and fade it out */
  box-shadow: 0 0 0 10px rgba(194, 38, 13, 0);
}
100% {
  /* Reset */
  box-shadow: 0 0 0 0 rgba(194, 38, 13, 0);
}
}

/* 2. Update the Class */
.pf-dot {
position: absolute;
width: 14px;
height: 14px;
background-color: #c2260d;
{% comment %} border: 2px solid #fff; {% endcomment %}
border-radius: 50%;
z-index: 30;
transform: translate(-50%, -50%);
cursor: pointer;
transition: transform 0.2s;

/* Add the animation here */
animation: pf-pulse 2s infinite;
}

/* Optional: Pause animation on hover */
.pf-dot:hover {
animation: none;
transform: translate(-50%, -50%) scale(1.1); /* Slight zoom on hover */
}

.pf-card {
background: #fff;
border-radius: 6px;
display: flex;
align-items: stretch;
position: relative;
width: 100%;
transition: transform 0.3s ease;
box-shadow: 0px 0px 10px 0px #00000026;
}

.pf-number {
background-color: #c2260d;
color: #fff;
font-family: Instrument Sans;
font-weight: 700;
font-size: 65px;
line-height: 100%;
letter-spacing: 0%;
text-align: center;
vertical-align: middle;
width: 70px;
display: flex;
align-items: center;
justify-content: center;
flex-shrink: 0;
border-top-left-radius: 5px;
border-bottom-left-radius: 5px;
}

.pf-card-content {
padding: 15px 20px;
flex-grow: 1;
}
.pf-card-title {
font-family: Instrument Sans;
font-weight: 600;
font-size: 16px;
line-height: 100%;
letter-spacing: 0%;
vertical-align: middle;
color: #000;
margin-bottom: 10px;
}

.pf-card-desc p{
font-family: Instrument Sans;
font-weight: 400;
font-size: 14px;
line-height: 130%;
letter-spacing: 0%;
margin: 0;
}

/* Navigation Arrows */
.pf-nav-btn {
position: absolute;
top: 50%;
transform: translateY(-50%);
z-index: 50;
width: 40px;
height: 40px;
border-radius: 50%;
cursor: pointer;
display: flex;
align-items: center;
justify-content: center;
color: #000;
transition: 0.3s;
}
/* Hides navigation buttons when there is only 1 slide */
.pf-nav-btn.swiper-button-lock {
display: none !important;
}

/* Optional: Hides the "Prev" arrow at the start and "Next" arrow at the end */
.pf-nav-btn.swiper-button-disabled {
opacity: 0.35; /* Change to display: none; if you want them to disappear completely */
pointer-events: none;
}
.pf-prev { left: -40px; }
.pf-next { right: -40px; }
@media (max-width: 1424px) {
.pf-col-left, .pf-col-right {
max-width: 300px;
}
  .pf-prev { left: 0px; top: 30%; }
.pf-next { right: 0px;top: 30%; }

}
@media (max-width: 1024px) {
.pf-container {
    background-color: transparent;
    padding-inline: 0 !important;
}
h2.pf-header {
    font-size: 38px;
}
.pf-col-left, .pf-col-right {
margin: 0;
}
.pf-slide-inner { flex-direction: column; padding-top: 20px; }
.pf-image-wrapper { 
order: 1; 
width: 100%; 
margin-bottom: 40px; 
height: 300px; 
}
.pf-image-wrapper img { max-height: 100%; width: auto; }
.pf-col-left, .pf-col-right { 
order: 2; 
width: 100%; 
max-width: 600px;
gap: 15px; 
margin-bottom: 5px;
}
.pf-svg-overlay, .pf-dot { display: none; }
.pf-card { margin-bottom: 10px; }
}
</style>


{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{% endstyle %}
<div class="pf-section container-x">
  <div class="pf-container container-xs section-{{ section.id }}-padding">
    {% if section.settings.heading != blank %}
      <h2 class="pf-header">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="swiper pf-swiper" id="pfSwiper-{{ section.id }}">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
        <div class="swiper-slide" {{ block.shopify_attributes }}>
          <div class="pf-slide-inner js-slide-container">
            <svg class="pf-svg-overlay" xmlns="http://www.w3.org/2000/svg">
              <path class="pf-connector-line js-line-1"></path>
              <path class="pf-connector-line js-line-2"></path>
              <path class="pf-connector-line js-line-3"></path>
            </svg>
            <div class="pf-col-left">
              <div class="pf-card js-card-1">
                <div class="pf-number">1</div>
                <div class="pf-card-content">
                  <div class="pf-card-title">{{ block.settings.f1_title }}</div>
                  <div class="pf-card-desc">{{ block.settings.f1_desc }}</div>
                </div>
              </div>
            </div>
            <div class="pf-image-wrapper js-image-area">
              {% if block.settings.image != blank %}
                {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
              <div class="pf-dot js-dot-1" style="left: {{ block.settings.f1_x }}%; top: {{ block.settings.f1_y }}%;"></div>
              <div class="pf-dot js-dot-2" style="left: {{ block.settings.f2_x }}%; top: {{ block.settings.f2_y }}%;"></div>
              <div class="pf-dot js-dot-3" style="left: {{ block.settings.f3_x }}%; top: {{ block.settings.f3_y }}%;"></div>
            </div>
            <div class="pf-col-right">
              <div class="pf-card js-card-2">
                <div class="pf-number">2</div>
                <div class="pf-card-content">
                  <div class="pf-card-title">{{ block.settings.f2_title }}</div>
                  <div class="pf-card-desc">{{ block.settings.f2_desc }}</div>
                </div>
              </div>
              <div class="pf-card js-card-3">
                <div class="pf-number">3</div>
                <div class="pf-card-content">
                  <div class="pf-card-title">{{ block.settings.f3_title }}</div>
                  <div class="pf-card-desc">{{ block.settings.f3_desc }}</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
      <div class="pf-nav-btn pf-prev">
   <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
<path d="M20 12L4 12M4 12L10 6M4 12L10 18" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
      </div>
      <div class="pf-nav-btn pf-next">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
<path d="M4 12L20 12M20 12L14 18M20 12L14 6" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const swiper = new Swiper('#pfSwiper-{{ section.id }}', {
      slidesPerView: 1,
      spaceBetween: 30,
      watchOverflow: true,
      loop: false,
      allowTouchMove: true,
      navigation: { nextEl: '.pf-next', prevEl: '.pf-prev' },
      effect: 'fade',
      fadeEffect: { crossFade: true },
      on: {
        init: function() { setTimeout(drawAllLines, 100); },
        resize: function() { drawAllLines(); }
      }
    });
    function drawAllLines() {
      const containers = document.querySelectorAll('.js-slide-container');
      
      containers.forEach(container => {
        const svg = container.querySelector('.pf-svg-overlay');
        if (!svg) return;
        drawConnector(container, '.js-card-1', '.js-dot-1', '.js-line-1', 'left'); // Left Card
        drawConnector(container, '.js-card-2', '.js-dot-2', '.js-line-2', 'right'); // Right Top
        drawConnector(container, '.js-card-3', '.js-dot-3', '.js-line-3', 'right'); // Right Bottom
      });
    }

    function drawConnector(container, cardSelector, dotSelector, lineSelector, side) {
      const card = container.querySelector(cardSelector);
      const dot = container.querySelector(dotSelector);
      const line = container.querySelector(lineSelector);

      if (!card || !dot || !line) return;
      const containerRect = container.getBoundingClientRect();
      const cardRect = card.getBoundingClientRect();
      const dotRect = dot.getBoundingClientRect();
      const cardRelativeLeft = cardRect.left - containerRect.left;
      const cardRelativeTop = cardRect.top - containerRect.top;
      const dotRelativeLeft = dotRect.left - containerRect.left;
      const dotRelativeTop = dotRect.top - containerRect.top;
      let startX, startY, endX, endY;

      if (side === 'left') {
        startX = cardRelativeLeft + cardRect.width;
        startY = cardRelativeTop + (cardRect.height / 2);
      } else {
        startX = cardRelativeLeft;
        startY = cardRelativeTop + (cardRect.height / 2);
      }

      endX = dotRelativeLeft + (dotRect.width / 2);
      endY = dotRelativeTop + (dotRect.height / 2);
      const kneeX = startX + (endX - startX) / 2;
      const pathString = `M ${startX} ${startY} L ${kneeX} ${startY} L ${kneeX} ${endY} L ${endX} ${endY}`;

      line.setAttribute('d', pathString);
    }
    window.addEventListener('resize', drawAllLines);
    document.addEventListener('shopify:section:load', drawAllLines);
    document.addEventListener('shopify:block:select', drawAllLines);
  });
</script>
