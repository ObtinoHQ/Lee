{%- style -%}
.section-{{ section.id }}-padding {
  padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
  padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  background-color: {{ section.settings.bg_color }};
  overflow: hidden;
}

@media screen and (min-width: 750px) {
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
}

.ts-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 5px;
  position: relative;
}

.ts-header-left {
  display: flex;
  align-items: center;
  gap: 20px;
}

.ts-title {
  font-family: Bebas Neue;
  font-weight: 400;
  font-style: Regular;
  font-size: 48px;
  line-height: 60px;
  letter-spacing: 0%;
  vertical-align: middle;
  text-transform: uppercase;
  margin: 0;
  color: {{ section.settings.text_color }};
}

.ts-nav-wrapper {
  display: flex;
  gap: 15px;
}

.ts-nav-btn {
  width: 24px;
  height: 24px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: {{ section.settings.text_color }};
  transition: opacity 0.3s;
}

.ts-nav-btn.swiper-button-disabled {
  opacity: 0.3;
  cursor: auto;
}

.ts-nav-btn svg {
  width: 100%;
  height: 100%;
  stroke-width: 1.5px;
}

.ts-card {
  background: #fff;
  border-radius: 5px;
  padding: 24px;
  height: auto;
  display: flex;
  flex-direction: column;
  box-shadow: 0px 0px 10px 0px #00000026;
}

.ts-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
}

.ts-quote-icon {
  font-size: 40px;
  line-height: 1;
  font-family: serif;
  font-weight: 900;
  color: #000;
}

.ts-stars {
  display: flex;
}

.ts-swiper-{{ section.id }} {
  padding: 30px 20px 50px 30px;
}

.ts-star-icon {
  width: 21px;
  height: 21px;
  fill: #FFCD09;
}

.ts-review-text p {
  font-family: Instrument Sans;
  font-weight: 500;
  font-style: Medium;
  font-size: 14px;
  line-height: 140%;
  letter-spacing: 0%;
  color: #000000;
  margin: 0px;
}
.ts-review-text {
    font-family: Instrument Sans;
    font-weight: 500;
    font-style: Medium;
    font-size: 14px;
    line-height: 140%;
    letter-spacing: 0%;
    color: #000000;
    margin: 0px;
}
.ts-author {
  font-family: Instrument Sans;
  font-weight: 400;
  font-style: Italic;
  font-size: 14px;
  line-height: 100%;
  letter-spacing: 0%;
  color: #000000;
  text-align: right;
}

@media screen and (max-width: 768px) {
.ts-title {
    font-size: 28px;
    line-height: 28px;
    width: 150px;
}
.ts-header-left {
    gap: 10px;
    flex-direction: column;
    align-items: start;
}

  .ts-swiper-{{ section.id }} {
    padding: 30px 10px 30px;
  }
}
{%- endstyle -%}


<div class="section-{{ section.id }}-padding">
  <div class="ts-container">
    
    <div class="ts-header container-x">
      <div class="ts-header-left">
        <h2 class="ts-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.link_text != blank -%}
          <a href="{{ section.settings.link_url }}" class="view-all">
            {{ section.settings.link_text }}
          </a>
        {%- endif -%}
      </div>

      <div class="ts-nav-wrapper">
        <div class="ts-nav-btn ts-prev-{{ section.id }}">
<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
<path d="M20 12L4 12M4 12L10 6M4 12L10 18" stroke="#000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
        </div>
        <div class="ts-nav-btn ts-next-{{ section.id }}">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none">
<path d="M4 12L20 12M20 12L14 18M20 12L14 6" stroke="black" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
</svg>
        </div>
      </div>
    </div>

    <div class="swiper ts-swiper-{{ section.id }} container-x">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="swiper-slide" {{ block.shopify_attributes }}>
            <div class="ts-card">
              <div class="ts-card-top">
              {%- if block.settings.quote_icon != blank -%}
  {{ block.settings.quote_icon | image_url: width: 40 | image_tag: class: 'ts-quote-icon', loading: 'lazy' }}
{%- else -%}
  <span class="ts-quote-icon">“</span>
{%- endif -%}
                <div class="ts-stars">
                  {%- for i in (1..5) -%}
                 {%- if block.settings.star_icon != blank -%}
      {{ block.settings.star_icon | image_url: width: 40 | image_tag: class: 'ts-star-icon', loading: 'lazy' }}
{%- endif -%}
{%- endfor -%}

                </div>
              </div>
              <div class="ts-review-text">
                {{ block.settings.review_text }}
              </div>
              <div class="ts-author">
                &mdash; {{ block.settings.author_name }}
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>

  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    new Swiper('.ts-swiper-{{ section.id }}', {
      slidesPerView: 1.1,
      spaceBetween: 16,
      navigation: {
        nextEl: '.ts-next-{{ section.id }}',
        prevEl: '.ts-prev-{{ section.id }}',
      },
      breakpoints: {
        640: {
          slidesPerView: 2.2,
          spaceBetween: 20,
        },
        1024: {
          slidesPerView: 3.5, /* Shows 3 full cards and half of the 4th */
          spaceBetween: 24,
        },
      }
    });
  });
</script>

{% schema %}
{
  "name": "Reviews Swiper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WHAT OUR CUSTOMERS SAY"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link Text",
      "default": "Read All 2,234 Reviews"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#f9f9f9"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        {
        "type": "image_picker",
        "id": "star_icon",
        "label": "Star Icon Image"
      },
              {
        "type": "image_picker",
        "id": "quote_icon",
        "label": "Quote Icon Image"
      },
        {
          "type": "text",
          "id": "review_text",
          "label": "Review Text",
          "default": "The most stable lifting shoes I've ever worn — perfect grip and balance on every squat."
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Author Name",
          "default": "Jonas P."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews Swiper",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}