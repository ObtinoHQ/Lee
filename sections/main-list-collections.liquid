{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .pro-coll-section {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .pro-coll-headline {
    font-size: 3.5rem;
    text-transform: uppercase;
    margin-bottom: 50px;
    letter-spacing: 1px;
    line-height: 1;
    text-align: center;
  }

  /* The Grid Strategy */
  .pro-coll-grid {
    display: grid;
    list-style: none;
    padding: 0;
    margin: 0;
    gap: 25px;
  }

  /* Desktop: 4 Columns as per your request */
  @media screen and (min-width: 990px) {
    .pro-coll-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }

  /* Mobile: 2 Columns */
  @media screen and (max-width: 989px) {
    .pro-coll-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
    .pro-coll-headline { font-size: 2.2rem; }
  }

  /* The Pro Card Structure */
  .pro-coll-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
  }

  /* Image Container - Strictly Square */
  .pro-coll-image-wrapper {
    background-color: #f7f7f7; 
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    margin-bottom: 15px;
    transition: background-color 0.3s ease;
  }

  .pro-coll-card:hover .pro-coll-image-wrapper {
    background-color: #efefef;
  }

  .pro-coll-image-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.5s ease;
  }

  .pro-coll-card:hover img {
    transform: scale(1.08);
  }

  /* Text Titles Above or Below - Reference uses Below */
  .pro-coll-info {
    text-align: left; /* Aligned left to match the arrow style */
    padding: 5px 0;
  }

.pro-coll-title {
    font-size: 2.1rem;
    text-transform: uppercase;
    color: #000;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    justify-content: center;
}
  .pro-coll-title svg {
    width: 16px;
    height: 16px;
  }
{%- endstyle -%}

<div class="pro-coll-section container-x">
  <h1 class="pro-coll-headline">{{ section.settings.title }}</h1>

  <ul class="pro-coll-grid">
    {%- for collection in collections -%}
      {%- comment -%} ONLY SHOW COLLECTIONS WITH IMAGES {%- endcomment -%}
      {%- if collection.featured_image != nil -%}
        <li>
          <a href="{{ collection.url }}" class="pro-coll-card">
            <div class="pro-coll-image-wrapper">
              <img
                src="{{ collection.featured_image | image_url: width: 600 }}"
                alt="{{ collection.title | escape }}"
                loading="lazy"
              >
            </div>
            
            <div class="pro-coll-info">
              <h2 class="pro-coll-title">
                {{ collection.title }}
                <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="black" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </h2>
            </div>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Pro List",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "Collections"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop Columns"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ]
}
{% endschema %}