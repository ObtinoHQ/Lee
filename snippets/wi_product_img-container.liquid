{% liquid
  assign section_id = section.id | default: 'product-grid'
  assign image_limit = 4
  assign image_count = card_product.images.size
  if image_count > image_limit
    assign image_count = image_limit
  endif
%}

<div class="WI_productCard_img hover-load-trigger" data-handle="{{ card_product.handle }}" style="display:none;">
  <div class="WI_productCard_img_in">
    <a href="{{ card_product.url }}" class="product-link"></a>

    <div class="WI_productCard_img_B_CSS">
      {%- for image in card_product.images limit: image_limit -%}
        <input
          type="radio"
          class="slide-input-{{ forloop.index }}"
          name="slider-{{ section_id }}-{{ card_product.id }}-{{ card_product.handle }}"
          id="slide-{{ section_id }}-{{ card_product.id }}-{{ forloop.index }}-{{ card_product.handle }}"
          {% if forloop.first %}checked{% endif %}
        >
      {%- endfor -%}

      <div class="WI_slider_track">
        {%- for image in card_product.images limit: image_limit -%}
          <div class="WI_slider_item">
            {% if forloop.first %}
              <img
                src="{{ image | image_url: width: 533 }}"
                alt="{{ image.alt | escape }}"
                loading="lazy"
                class="img-main"
                width="533"
                height="{{ 533 | divided_by: image.aspect_ratio | ceil }}"
                data-media-id="{{ image.id }}"  {% comment %} <-- ADD THIS {% endcomment %}
              >
              {% if card_product.images[1] != blank %}
                <img
                  src="{{ card_product.images[1] | image_url: width: 533 }}"
                  alt="{{ card_product.images[1].alt | escape }}"
                  loading="lazy"
                  class="img-secondary"
                  width="533"
                  height="{{ 533 | divided_by: card_product.images[1].aspect_ratio | ceil }}"
                >
              {% endif %}
            
            {% else %}
              <img
                data-src="{{ image | image_url: width: 533 }}"
                src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw=="
                alt="{{ image.alt | escape }}"
                class="img-main swiper-lazy-load"
                width="533"
                height="{{ 533 | divided_by: image.aspect_ratio | ceil }}"
                style="object-fit: contain;"
                data-media-id="{{ image.id }}" {% comment %} <-- ADD THIS {% endcomment %}
              >
            {% endif %}
          </div>
        {%- endfor -%}
      </div>

      {% if image_count > 1 %}
        <div class="WI_controls_CSS">
          <div class="WI_arrow_box WI_prev_btn">
            <div class="WI_arrow_disabled">
               <svg xmlns="http://www.w3.org/2000/svg" width="9" height="14" viewBox="0 0 9 14" fill="none"><path d="M7.41431 0.707092L1.41431 6.70709L7.41431 12.7071" stroke="#333333" stroke-width="2"/></svg>
            </div>
            {% for i in (1..image_count) %}
              {% if i > 1 %}
                {% assign target = i | minus: 1 %}
                <label class="WI_arrow_label to-slide-{{ target }}" for="slide-{{ section_id }}-{{ card_product.id }}-{{ target }}-{{ card_product.handle }}">
                   <svg xmlns="http://www.w3.org/2000/svg" width="9" height="14" viewBox="0 0 9 14" fill="none"><path d="M7.41431 0.707092L1.41431 6.70709L7.41431 12.7071" stroke="#333333" stroke-width="2"/></svg>
                </label>
              {% endif %}
            {% endfor %}
          </div>
          <div class="WI_arrow_box WI_next_btn">
            <div class="WI_arrow_disabled">
              <svg width="9" height="14" viewBox="0 0 9 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.707031 0.707092L6.70703 6.70709L0.707031 12.7071" stroke="#333333" stroke-width="2"/></svg>
            </div>
            {% for i in (1..image_count) %}
              {% if i < image_count %}
                {% assign target = i | plus: 1 %}
                <label class="WI_arrow_label to-slide-{{ target }}" for="slide-{{ section_id }}-{{ card_product.id }}-{{ target }}-{{ card_product.handle }}">
                   <svg width="9" height="14" viewBox="0 0 9 14" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M0.707031 0.707092L6.70703 6.70709L0.707031 12.7071" stroke="#333333" stroke-width="2"/></svg>
                </label>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="card__content badge-custom">
    <div class="card__badge {{ settings.badge_position }}">
      {%- if card_product.available == false -%}
        <span class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">
          {{- 'products.product.sold_out' | t -}}
        </span>
      {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
        <span class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">
          {{- 'products.product.on_sale' | t -}}
        </span>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function() {
  // Use IntersectionObserver or simple event listeners
  const productCards = document.querySelectorAll('.hover-load-trigger');

  function loadSliderImages(card) {
    // Find all images inside this card that have data-src
    const lazyImages = card.querySelectorAll('img.swiper-lazy-load[data-src]');
    
    lazyImages.forEach(img => {
      img.src = img.getAttribute('data-src');
      img.removeAttribute('data-src');
      img.classList.remove('swiper-lazy-load');
    });

    // Remove the event listener so this only runs once per card
    card.removeAttribute('onmouseover');
    card.removeEventListener('mouseover', handleInteraction);
    card.removeEventListener('touchstart', handleInteraction);
    card.classList.add('images-loaded');
  }

  function handleInteraction(e) {
    const card = e.currentTarget;
    // Check if we already loaded images for this card
    if (!card.classList.contains('images-loaded')) {
      loadSliderImages(card);
    }
  }

  // Attach listeners to all cards
  productCards.forEach(card => {
    // Load on hover (Desktop)
    card.addEventListener('mouseover', handleInteraction, { passive: true });
    // Load on touch (Mobile)
    card.addEventListener('touchstart', handleInteraction, { passive: true });
  });
});
</script>