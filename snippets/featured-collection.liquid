<div class="megamenu-coll__section">
    <div class="megamenu-coll__list">
    {%- for i in (1..5) -%}
      {%- assign col_id = 'collection_' | append: i -%}
      {%- assign img_id = 'custom_image_' | append: i -%}
      {%- assign title_id = 'custom_title_' | append: i -%}
      
      {%- assign col = block.settings[col_id] -%}
      {%- assign custom_img = block.settings[img_id] -%}
      {%- assign custom_title = block.settings[title_id] -%}

      {%- if col != blank -%}
        <a href="{{ col.url }}" class="megamenu-coll__item">
          <div class="megamenu-coll__img-box">
            {%- if custom_img != blank -%}
              <img src="{{ custom_img | image_url: width: 150 }}" alt="{{ custom_img.alt | escape }}" class="megamenu-coll__img" loading="lazy">
            {%- elsif col.featured_image != blank -%}
              <img src="{{ col.featured_image | image_url: width: 150 }}" alt="{{ col.title | escape }}" class="megamenu-coll__img" loading="lazy">
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'megamenu-coll__img placeholder-svg' }}
            {%- endif -%}
          </div>
          
          <span class="megamenu-coll__label">
            {%- if custom_title != blank -%}
              {{ custom_title }}
            {%- else -%}
              {{ col.title }}
            {%- endif -%}
          </span>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

<style>

    .megamenu-coll__list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .megamenu-coll__item {
        display: flex;
        align-items: center;
        text-decoration: none !important;
        color: inherit;
        outline: none;
    }

    .megamenu-coll__img-box {
        width: 150px;
        height: 100px;
        border-radius: 6px;
        overflow: hidden;
        flex-shrink: 0;
        margin-right: 15px;
    }

    .megamenu-coll__img-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .megamenu-coll__label {
        font-size: 18px;
        font-weight: 600;
        color: #121212;
        letter-spacing: -0.01em;
    }

    /* Subtle hover for interactivity */
    .megamenu-coll__item:hover .megamenu-coll__label {
        opacity: 0.7;
    }
</style>