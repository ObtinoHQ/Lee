

<style>
  .mobileMega-wrapper {
    padding: 10px 0;
    display: flex;
    flex-direction: column;
    gap: 25px;
  }
  
  .mobileMega-block-heading {
    font-size: 1.6rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-block: 15px;
    padding-left: 2rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
  }
.mobileMega-block .menu-drawer__menu-item{
    font-size: 15px;
} 


  .mobileMega-banner {
    padding: 0 1.5rem;
  }
  .mobileMega-banner img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    display: block;
    object-fit: cover;
  }
  .mobileMega-banner-content { margin-top: 10px; }
  .mobileMega-banner-title {
    font-weight: 600;
    font-size: 1.4rem;
    display: block;
    text-decoration: none;
    color: rgb(var(--color-foreground));
    margin-bottom: 5px;
  }
  .mobileMega-banner-btn {
    font-size: 1.3rem;
    text-decoration: underline;
    color: rgba(var(--color-foreground), 0.8);
  }

  /* --- Collections List --- */
  .mobileMega-collection-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    padding: 0 2rem;
  }
  .mobileMega-collection-item {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    color: rgb(var(--color-foreground));
  }
.mobileMega-collection-img {
    width: 80px;
    height: 70px;
    border-radius: 10px;
    object-fit: cover;
    background-color: #f0f0f0;
}
 .mobileMega-collection-title {
    font-weight: 500;
    font-size: 1.5rem;
    letter-spacing: 1px;
}
.mobileMega-category-list {
    padding: 0 2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    width: 100%;
}
.mobileMega-category-item {
    text-decoration: none;
    color: rgb(var(--color-foreground));
    border-bottom: 1px solid rgba(0,0,0,0.05);
    padding-bottom: 10px;
    width: calc(50% - 10px);
}
.mobileMega-cat-title {
    font-weight: 500;
    font-size: 1.6rem;
    margin-bottom: 10px;
    display: block;
    color: black;
    text-decoration: none;
    letter-spacing: 1px;
}
.mobileMega-cat-desc {
    display: flex;
    flex-direction: column;
    gap: 5px;
}
  .mobileMega-cat-desc p {
    font-size: 1.3rem;
    color: black;
    margin: 0;
    line-height: 1.4;
  }

.mobileMega-cat-desc a{
    color: black;
}
  .mobileMega-bottom {
    background-color: #f9f9f9;
    padding: 20px 2rem;
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
  }
  .mobileMega-bottom-link {
    font-weight: 600;
    font-size: 1.6rem;
    text-decoration: none;
    letter-spacing: 1px;
  }
  .menu-drawer__menu-item{
    justify-content: space-between;
  }
</style>

<header-drawer data-breakpoint="{% if section.settings.menu_type_desktop == 'drawer' %}desktop{% else %}tablet{% endif %}">
  <details id="Details-menu-drawer-container" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
<svg class="icon icon-hamburger" xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" fill="none">
<path d="M18.375 3.5H2.625V5.25H18.375V3.5ZM13.125 9.625H2.625V11.375H13.125V9.625ZM18.375 15.75H2.625V17.5H18.375V15.75Z" fill="white"/>
</svg>
        {% render 'icon-close' %}
      </span>
    </summary>
    <div id="menu-drawer" class="gradient menu-drawer motion-reduce color-{{ section.settings.menu_color_scheme }}">
      <div class="menu-drawer__inner-container">
        <div class="menu-drawer__navigation-container">
          <nav class="menu-drawer__navigation">
            <ul class="menu-drawer__menu has-submenu list-menu" role="list">
              {%- for link in section.settings.menu.links -%}
                {% assign hasBlock = false %}
                {% for block in section.blocks %}
                  {% if block.type == 'megamenu' or block.type == 'collections' or block.type == 'categories' or block.type == 'bottom' or block.type == 'image-cards-grid' or block.type == 'text-column' %}
                    {% assign matched_link = block.settings.title | downcase %}
                    {% assign menu_link = link.title | downcase %}
                    {%- if matched_link == menu_link -%}
                      {% assign hasBlock = true %}
                    {% endif %}
                  {% endif %}
                {% endfor %}

                <li>
                  {% if hasBlock == true or link.links != blank %}
                      <details id="Details-menu-drawer-menu-item-{{ forloop.index }}">
                        <summary
                          id="HeaderDrawer-{{ link.handle }}"
                          class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                        >
                          {{ link.title | escape }}
                          {% render 'icon-arrow' %}
  
                        </summary>

                        <div
                          id="link-{{ link.handle | escape }}"
                          class="menu-drawer__submenu has-submenu gradient motion-reduce"
                          tabindex="-1"
                        >
                          <div class="menu-drawer__inner-submenu">
                            <button class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                              {% render 'icon-arrow' %}
                              {{ link.title | escape }}
                            </button>
                            
                            
                            {% if hasBlock %}
                              <div class="mobileMega-wrapper">
                                
                                {%- for block in section.blocks -%}
                                  {% assign matched_link = block.settings.title | downcase %}
                                  {% assign menu_link = link.title | downcase %}
                                  {%- if matched_link == menu_link and block.type != 'bottom' -%}
                                    
                                    {% case block.type %}
                                      
                                  {% when 'megamenu' %}
                                      {%- comment -%} 
                                        Loop through 1 to 3 to handle multiple menu selections 
                                      {%- endcomment -%}
                                      {%- for i in (1..3) -%}
                                        {%- assign menu_id = 'menu_' | append: i -%}
                                        {%- assign current_menu = block.settings[menu_id] -%}

                                        {%- if current_menu != blank -%}
                                          <div class="mobileMega-block">
                                            {%- comment -%} Display the menu title if it exists {%- endcomment -%}
                                            <div class="mobileMega-block-heading">
                                              {{ current_menu.title }}
                                            </div>
                                            
                                            <ul class="menu-drawer__menu list-menu" role="list">
                                              {%- for childlink in current_menu.links -%}
                                                <li>
                                                  <a href="{{ childlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                                    {{ childlink.title }}
                                                  </a>
                                                </li>
                                              {%- endfor -%}
                                            </ul>
                                          </div>
                                        {%- endif -%}
                                      {%- endfor -%}

                                      {%- comment -%} Banner Section remains at the bottom {%- endcomment -%}
                                      <div class="mobileMega-banner">
                                        {% if block.settings.image != blank %}
                                          <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.banner_title | escape }}" loading="lazy">
                                        {% endif %}
                                        <div class="mobileMega-banner-content">
                                          {% if block.settings.banner_title != blank %}
                                            <a href="{{ block.settings.banner_link }}" class="mobileMega-banner-title">{{ block.settings.banner_title }}</a>
                                          {% endif %}
                                          {% if block.settings.banner_button != blank %}
                                            <a href="{{ block.settings.banner_link }}" class="mobileMega-banner-btn">{{ block.settings.banner_button }}</a>
                                          {% endif %}
                                        </div>
                                      </div>
                                 

                                      {%- comment -%} === COLLECTIONS (5 Slots) === {%- endcomment -%}
                                      {% when 'collections' %}
                                        <div class="mobileMega-block">
                                          {% if block.settings.heading != blank %}
                                            <div class="mobileMega-block-heading">{{ block.settings.heading }}</div>
                                          {% endif %}
                                          <div class="mobileMega-collection-list">
                                            {% for i in (1..5) %}
                                              {% capture col_id %}collection_{{i}}{% endcapture %}
                                              {% capture img_id %}custom_image_{{i}}{% endcapture %}
                                              {% capture title_id %}custom_title_{{i}}{% endcapture %}
                                              
                                              {% assign col = block.settings[col_id] %}
                                              {% assign img = block.settings[img_id] %}
                                              {% assign custom_title = block.settings[title_id] %}

                                              {% if col != blank %}
                                                <a href="{{ col.url }}" class="mobileMega-collection-item">
                                                  {% if img != blank %}
                                                    <img src="{{ img | image_url }}" class="mobileMega-collection-img">
                                                  {% elsif col.image != blank %}
                                                     <img src="{{ col.image | image_url }}" class="mobileMega-collection-img">
                                                  {% endif %}
                                                  <span class="mobileMega-collection-title">
                                                    {% if custom_title != blank %}{{ custom_title }}{% else %}{{ col.title }}{% endif %}
                                                  </span>
                                                </a>
                                              {% endif %}
                                            {% endfor %}
                                          </div>
                                        </div>

                                      {% when 'categories' %}
                                         <div class="mobileMega-block">
                                          {% if block.settings.heading != blank %}
                                            <div class="mobileMega-block-heading">{{ block.settings.heading }}</div>
                                          {% endif %}
                                        <div class="mobileMega-category-list">
                                            {% for i in (1..8) %}
                                              {% capture col_id %}collection_{{i}}{% endcapture %}
                                              {% capture title_id %}custom_title_{{i}}{% endcapture %}
                                              {% capture desc_id %}custom_desc_{{i}}{% endcapture %}
                                              
                                              {% assign col = block.settings[col_id] %}
                                              {% assign custom_title = block.settings[title_id] %}
                                              {% assign custom_desc = block.settings[desc_id] %}

                                              {% if col != blank or custom_title != blank %}
                                                <div class="mobileMega-category-item">
                                                  
                                                  <a href="{{ col.url | default: '#' }}" class="mobileMega-cat-title">
                                                    {% if custom_title != blank %}{{ custom_title }}{% else %}{{ col.title }}{% endif %}
                                                  </a>

                                                  {% if custom_desc != blank %}
                                                    <div class="mobileMega-cat-desc">{{ custom_desc }}</div>
                                                  {% endif %}
                                                  
                                                </div>
                                              {% endif %}
                                            {% endfor %}
                                          </div>
                                         </div>
                                        {% when 'image-cards-grid' %}
                                          <div class="mobileMega-block">
                                          {% if block.settings.heading != blank %}
                                            <div class="mobileMega-block-heading">{{ block.settings.heading }}</div>
                                          {% endif %}
                                          {% render 'images-grid', block: block %}
                                          </div>
                                        {% when 'text-column' %}
                                          <div class="mobileMega-block">
                                          {% if block.settings.heading != blank %}
                                            <div class="mobileMega-block-heading">{{ block.settings.heading }}</div>
                                          {% endif %}
                                          {% render 'megamenu-text-column', block: block %}
                                          </div>

                                    {% endcase %}
                                  {%- endif -%}
                                {%- endfor -%}
                                {%- for block in section.blocks -%}
                                  {% assign matched_link = block.settings.title | downcase %}
                                  {% assign menu_link = link.title | downcase %}
                                  {%- if matched_link == menu_link and block.type != 'bottom' -%}
                                    {% case block.type %}
                                      {% when 'bottom' %}
                                              <div class="mobileMega-bottom">
                                                {% if block.settings.link_1_text != blank %}
                                                  <a href="{{ block.settings.link_1_url }}" class="mobileMega-bottom-link" style="color: {{ block.settings.link_color_1 }}">
                                                    {{ block.settings.link_1_text }}
                                                  </a>
                                                {% endif %}
                                                {% if block.settings.link_2_text != blank %}
                                                  <a href="{{ block.settings.link_2_url }}" class="mobileMega-bottom-link" style="color: {{ block.settings.link_color_2 }}">
                                                    {{ block.settings.link_2_text }}
                                                  </a>
                                                {% endif %}
                                              </div>

                                          {% endcase %}
                                        {% endif %}
                                    {%- endfor -%}

                              </div>

                            {% else %}
                              <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                                {%- for childlink in link.links -%}
                                  <li>
                                    <a href="{{ childlink.url }}" class="menu-drawer__menu-item link link--text list-menu__item focus-inset">
                                      {{ childlink.title | escape }}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            {% endif %}
                            
                          </div>
                        </div>
                      </details>
                  {% else %}
                    <a
                      id="HeaderDrawer-{{ link.handle }}"
                      href="{{ link.url }}"
                      class="menu-drawer__menu-item list-menu__item link link--text focus-inset"
                    >
                      {{ link.title | escape }}
                    </a>
                  {% endif %}
                </li>
              {%- endfor -%}
            </ul>
          </nav>
              <div class="woc-drawer-footer">
                <a
                  href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                  class="woc-drawer-footer__account"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                  Account
                </a>
              </div>
        </div>
        
      </div>
    </div>
  </details>
  {% render 'header-search', input_id: 'Search-In-Modal' %}
</header-drawer>

<style>
summary#HeaderDrawer-shop {
    justify-content: space-between;
}
.menu-drawer__inner-submenu svg{
    transform: rotate(-180deg);
}
</style>